{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkora",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [],
  "ai": { "binding": "AI" },
  "workers_dev": true
}
